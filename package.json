{
  "name": "anycode",
  "version": "0.1.0",
  "description": "Agentic coding CLI that works with any model: Anthropic, OpenAI-compatible endpoints, or local servers (Ollama, llama.cpp, vLLM, LM Studio).",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "bin": { "anycode": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
